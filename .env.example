# ApexBet local environment configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# All values here are safe local defaults and require no AWS account.

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
APEXBET_ENV=local
APEXBET_LOG_LEVEL=INFO
APEXBET_LOG_JSON=true
# Random seed used by the synthetic generator for reproducibility.
APEXBET_SEED=1337

# ---------------------------------------------------------------------------
# Streaming transport selection: "redpanda" | "kinesis" | "memory"
# The platform never silently falls back; an invalid choice fails fast.
# ---------------------------------------------------------------------------
APEXBET_TRANSPORT=redpanda

# --- Redpanda (Kafka-compatible) ---
APEXBET_KAFKA_BOOTSTRAP=localhost:19092
APEXBET_KAFKA_TOPIC=apexbet.events.v1
APEXBET_KAFKA_DLQ_TOPIC=apexbet.events.dlq.v1
APEXBET_KAFKA_GROUP_ID=apexbet-consumers

# --- AWS / LocalStack Kinesis ---
# LocalStack endpoints are only used when APEXBET_TRANSPORT=kinesis.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
APEXBET_KINESIS_STREAM=apexbet-events
APEXBET_KINESIS_SHARDS=2
# Set to 1 to use real AWS endpoints (requires credentials + billing acceptance).
APEXBET_USE_REAL_AWS=0

# ---------------------------------------------------------------------------
# Object storage (data lake). Backend: "local" | "s3"
# "s3" targets LocalStack S3 (or MinIO) via AWS_ENDPOINT_URL.
# ---------------------------------------------------------------------------
APEXBET_STORAGE_BACKEND=local
APEXBET_LAKE_ROOT=./lake
APEXBET_S3_BUCKET=apexbet-lake
APEXBET_S3_PREFIX=

# ---------------------------------------------------------------------------
# FastAPI ingestion
# ---------------------------------------------------------------------------
APEXBET_API_HOST=0.0.0.0
APEXBET_API_PORT=8000
APEXBET_API_MAX_BODY_BYTES=1048576
APEXBET_API_RATE_LIMIT_PER_SEC=2000
# Comma-separated bearer tokens. Leave empty to disable auth locally.
APEXBET_API_TOKENS=
# Comma-separated path prefixes that REQUIRE a token when tokens are set.
APEXBET_API_PROTECTED_PREFIXES=/api/v1/platform
# CORS origins allowed to call the API from the dashboard dev server.
APEXBET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Processing tuning
# ---------------------------------------------------------------------------
APEXBET_BRONZE_FLUSH_SECONDS=5
APEXBET_BRONZE_FLUSH_RECORDS=5000
APEXBET_DEDUP_WINDOW_SECONDS=3600
APEXBET_ALLOWED_LATENESS_SECONDS=600
APEXBET_MAX_RETRIES=5
APEXBET_RETRY_BASE_SECONDS=0.5

# ---------------------------------------------------------------------------
# Analytics / serving
# ---------------------------------------------------------------------------
APEXBET_DUCKDB_PATH=./lake/analytics.duckdb

# ---------------------------------------------------------------------------
# Record enrichment
# ---------------------------------------------------------------------------
# Modes: "rules" (always available), "local_ml" (sklearn), "llm" (optional Ollama)
APEXBET_ENRICHMENT_MODE=rules
APEXBET_LLM_ENABLED=0
APEXBET_LLM_BASE_URL=http://localhost:11434
APEXBET_LLM_MODEL=llama3.2:3b
APEXBET_LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
APEXBET_METRICS_PORT=9101

# ---------------------------------------------------------------------------
# PostgreSQL (metadata / serving; extended "full" profile only)
# ---------------------------------------------------------------------------
APEXBET_POSTGRES_DSN=postgresql://apexbet:apexbet@localhost:5432/apexbet
