          "UP",
          "DOWN",
          "UNCHANGED"
        ],
        "title": "Movement Direction",
        "type": "string"
      },
      "new_odds": {
        "exclusiveMinimum": 1.0,
        "title": "New Odds",
        "type": "number"
      },
      "outcome_id": {
        "title": "Outcome Id",
        "type": "string"
      },
      "previous_odds": {
        "exclusiveMinimum": 1.0,
        "title": "Previous Odds",
        "type": "number"
      },
      "sequence": {
        "default": 0,
        "title": "Sequence",
        "type": "integer"
      }
    },
    "required": [
      "market_id",
      "outcome_id",
      "previous_odds",
      "new_odds"
    ],
    "title": "OddsUpdatedPayload",
    "type": "object"
  },
  "PipelineHealthEventPayload": {
    "additionalProperties": true,
    "properties": {
      "component": {
        "title": "Component",
        "type": "string"
      },
      "detail": {
        "default": "",
