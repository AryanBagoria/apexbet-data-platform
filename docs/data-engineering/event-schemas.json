    "title": "GameSessionEndedPayload",
    "type": "object"
  },
  "GameSessionStartedPayload": {
    "additionalProperties": true,
    "properties": {
      "currency": {
        "maxLength": 3,
        "minLength": 3,
        "title": "Currency",
        "type": "string"
      },
      "device": {
        "default": "web",
        "title": "Device",
        "type": "string"
      },
      "game_id": {
        "title": "Game Id",
        "type": "string"
      },
      "game_type": {
        "enum": [
