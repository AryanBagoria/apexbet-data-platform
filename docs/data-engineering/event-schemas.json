        "type": "string"
      },
      "starting_balance_minor": {
        "minimum": 0,
        "title": "Starting Balance Minor",
        "type": "integer"
      }
    },
    "required": [
      "game_type",
      "game_id",
      "starting_balance_minor",
      "currency"
    ],
    "title": "GameSessionStartedPayload",
    "type": "object"
  },
